<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="iPhoneCenter — atendimento e produtos Apple.">
  <title>iPhoneCenter | Seu iPhone, sempre com você</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="nav">
    <a class="brand" href="/">
      <img src="/assets/logo.png" alt="iPhoneCenter" onerror="this.style.display='none'">
      <span>iPhone<span>Center</span></span>
    </a>
    <nav>
      <a href="#produtos">Produtos</a>
      <a href="#sobre">Sobre</a>
      <a class="nav-cta" href="#atendimento">Atendimento</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow">IPHONECENTER</div>
        <h1>Seu próximo iPhone começa aqui.</h1>
        <p>Consulte modelos, disponibilidade e condições de atendimento em poucos passos.</p>
        <div class="actions">
          <a class="button primary" href="#atendimento">Quero atendimento</a>
          <a class="button ghost" href="#produtos">Ver modelos</a>
        </div>
        <div class="whatsapp-cta">
        <a class="button primary" href="https://wa.me/5511951507876?text=Ol%C3%A1!%20Vim%20pelo%20site%20iPhoneCenter%20e%20gostaria%20de%20saber%20mais%20sobre%20os%20iPhones." target="_blank" rel="noopener">
          Falar pelo WhatsApp
        </a>
      </div>
      <div class="trust">
          <span>✓ Atendimento personalizado</span>
          <span>✓ Dados tratados com transparência</span>
        </div>
      </div>
      <div class="hero-art">
        <img src="/assets/logo.png" alt="Identidade visual iPhoneCenter">
      </div>
    </section>

    <section id="produtos" class="section">
      <div class="section-head">
        <div>
          <div class="eyebrow">CATÁLOGO</div>
          <h2>Escolha seu modelo</h2>
        </div>
        <p>Consulte disponibilidade e condições de atendimento.</p>
      </div>

      <div class="cards">

        <article class="card">
          <img class="product-image" src="/assets/products/iphone15.png" alt="iPhone 15">
          <h3>iPhone 15</h3>
          <p>128 GB</p>
          <strong>R$ 2.899,99</strong>
          <br><br>
          <a class="button ghost" href="#atendimento" onclick="selectProduct(this)">Consultar</a>
          <a class="button ghost" href="#" onclick="openWhatsApp(this); return false;">WhatsApp</a>
        </article>

        <article class="card">
          <img class="product-image" src="/assets/products/iphone15-256.png" alt="iPhone 15 256 GB">
          <h3>iPhone 15</h3>
          <p>256 GB</p>
          <strong>R$ 3.199,99</strong>
          <br><br>
          <a class="button ghost" href="#atendimento" onclick="selectProduct(this)">Consultar</a>
          <a class="button ghost" href="#" onclick="openWhatsApp(this); return false;">WhatsApp</a>
        </article>

        <article class="card">
          <img class="product-image" src="/assets/products/iphone15pro.png" alt="iPhone 15 Pro">
          <h3>iPhone 15 Pro</h3>
          <p>128 GB</p>
          <strong>R$ 3.499,99</strong>
          <br><br>
          <a class="button ghost" href="#atendimento" onclick="selectProduct(this)">Consultar</a>
          <a class="button ghost" href="#" onclick="openWhatsApp(this); return false;">WhatsApp</a>
        </article>

        <article class="card">
          <img class="product-image" src="/assets/products/iphone16.png" alt="iPhone 16">
          <h3>iPhone 16</h3>
          <p>128 GB</p>
          <strong>R$ 4.199,99</strong>
          <br><br>
          <a class="button ghost" href="#atendimento" onclick="selectProduct(this)">Consultar</a>
          <a class="button ghost" href="#" onclick="openWhatsApp(this); return false;">WhatsApp</a>
        </article>

      </div>
    </section>

    <section id="sobre" class="dark-section">
      <div class="section-head">
        <div>
          <div class="eyebrow">IPHONECENTER</div>
          <h2>Atendimento simples, claro e personalizado.</h2>
        </div>
        <p>Conte o que você procura e nossa equipe poderá entrar em contato para orientar sobre modelos, capacidade, disponibilidade e condições de atendimento.</p>
      </div>

      <div class="cards">
        <article class="card">
          <h3>📱 Modelos</h3>
          <p>Consulte os aparelhos disponíveis e encontre o modelo que procura.</p>
        </article>

        <article class="card">
          <h3>💬 Atendimento</h3>
          <p>Fale conosco pelo formulário ou diretamente pelo WhatsApp.</p>
        </article>

        <article class="card">
          <h3>🔒 Privacidade</h3>
          <p>Seus dados são utilizados para responder à sua solicitação de atendimento.</p>
        </article>
      </div>
    </section>

    <section id="atendimento" class="section form-section">
      <div class="form-intro">
        <div class="eyebrow">ATENDIMENTO</div>
        <h2>Solicite informações</h2>
        <p>Preencha apenas os dados necessários para que possamos responder ao seu pedido.</p>
        <div class="privacy-note">
          <strong>Privacidade</strong>
          <p>Não solicitamos senha, código de verificação, dados completos de cartão ou outras credenciais de acesso. Use este formulário somente para a finalidade descrita.</p>
        </div>
      </div>

      <form id="leadForm" class="form">
        <label>Nome completo*<input name="name" required maxlength="120" autocomplete="name"></label>
        <label>WhatsApp / telefone*<input name="phone" required maxlength="40" autocomplete="tel"></label>
        <label>E-mail<input type="email" name="email" maxlength="160" autocomplete="email"></label>
        <label>Produto de interesse*
          <select name="product" required>
            <option value="">Selecione</option>
            <option>iPhone Pro</option>
            <option>iPhone</option>
            <option>Acessório</option>
            <option>Outro modelo</option>
          </select>
        </label>
        <label>Cidade para entrega/atendimento<input name="deliveryCity" maxlength="120" autocomplete="address-level2"></label>
        <label>Mensagem<textarea name="message" rows="4" maxlength="1000" placeholder="Ex.: modelo, capacidade ou dúvida."></textarea></label>

        <label class="check">
          <input type="checkbox" name="consent" required>
          <span>Li e concordo com a <a href="/privacidade.html" target="_blank">Política de Privacidade</a> e autorizo o tratamento dos dados para responder à minha solicitação.</span>
        </label>

        <button class="button primary full" type="submit">Enviar solicitação</button>
        <div id="formStatus" class="status" role="status"></div>
      </form>
    </section>
  </main>

  <footer>
    <div><strong>iPhoneCenter</strong><br><span>Seu iPhone, sempre com você.</span></div>
    <div><a href="/privacidade.html">Política de Privacidade</a></div>
  </footer>
  <script src="/app.js"></script>

<script>
function openWhatsApp(button) {
  const card = button.closest(".card");
  if (!card) return;

  const title = card.querySelector("h3")?.textContent.trim() || "";
  const storage = card.querySelector("p")?.textContent.trim() || "";
  const price = card.querySelector("strong")?.textContent.trim() || "";

  const product = [title, storage, price].filter(Boolean).join(" — ");
  const message = `Olá! Tenho interesse no ${product}. Gostaria de saber mais informações.`;

  window.open(
    "https://wa.me/5511951507876?text=" + encodeURIComponent(message),
    "_blank",
    "noopener"
  );
}
</script>

</body>
</html>
