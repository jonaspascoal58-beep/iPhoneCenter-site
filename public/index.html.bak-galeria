  position: relative;
  overflow: visible !important;
  background:
    radial-gradient(
      ellipse 900px 900px at 50% 45%,
      rgba(40, 120, 255, 0.10) 0%,
      rgba(40, 120, 255, 0.07) 30%,
      rgba(40, 120, 255, 0.04) 55%,
      rgba(40, 120, 255, 0) 80%
    ),
    radial-gradient(
