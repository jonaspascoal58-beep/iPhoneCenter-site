    height: 48px;
  }
}


/* Brilho azul contínuo em toda a página */
html {
  background:
    radial-gradient(
      ellipse 500px 900px at -80px 50%,
      rgba(40, 120, 255, 0.16) 0%,
      rgba(40, 120, 255, 0.08) 35%,
      rgba(40, 120, 255, 0) 75%
    ),
    radial-gradient(
      ellipse 500px 900px at calc(100% + 80px) 50%,
      rgba(40, 120, 255, 0.16) 0%,
      rgba(40, 120, 255, 0.08) 35%,
      rgba(40, 120, 255, 0) 75%
    );
  background-attachment: fixed;
}

body {
  position: relative;
  background: transparent !important;
}


