    <a href="#produtos" class="model-category" data-model="iPhone 11 Pro Max">iPhone 11 Pro Max</a>
    <a href="#produtos" class="model-category" data-model="iPhone 12 mini">iPhone 12 mini</a>
    <a href="#produtos" class="model-category" data-model="iPhone 12">iPhone 12</a>
    <a href="#produtos" class="model-category" data-model="iPhone 12 Pro">iPhone 12 Pro</a>
    <a href="#produtos" class="model-category" data-model="iPhone 12 Pro Max">iPhone 12 Pro Max</a>
    <a href="#produtos" class="model-category" data-model="iPhone 13">iPhone 13</a>
