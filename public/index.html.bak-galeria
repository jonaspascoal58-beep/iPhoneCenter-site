<script src="/app.js"></script>

<script>

function changeProductImage(button, imageUrl) {
  const gallery = button.closest(".product-gallery");
  if (!gallery) return;

  const mainImage = gallery.querySelector(".gallery-main-image");
  if (!mainImage) return;

  mainImage.src = imageUrl;

  gallery.querySelectorAll(".gallery-thumb").forEach((thumb) => {
    thumb.classList.remove("active");
  });

  button.classList.add("active");
}

document.addEventListener("DOMContentLoaded", function () {

  const searchForm = document.querySelector(".header-search");
  const searchInput = searchForm ? searchForm.querySelector("input") : null;

  if (searchForm && searchInput) {
    searchForm.addEventListener("submit", function (event) {
      event.preventDefault();

      const query = searchInput.value.trim().toLowerCase();
      const cards = document.querySelectorAll("#produtos .product-card");

      cards.forEach((card) => {
        const index = Number(card.dataset.productIndex);
        const product = window.products[index];

        if (!product) return;

        const text = [
          product.name || "",
          product.description || "",
          product.status || "",
          ...(Array.isArray(product.colors) ? product.colors : []),
          ...(Array.isArray(product.storages)
            ? product.storages.map(item => item.storage || "")
            : [])
        ].join(" ").toLowerCase();

        card.style.display = !query || text.includes(query) ? "" : "none";
      });

      const produtos = document.getElementById("produtos");

      if (produtos) {
        produtos.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }
    });

    searchInput.addEventListener("input", function () {
      if (this.value.trim() === "") {
        document.querySelectorAll("#produtos .product-card").forEach((card) => {
          card.style.display = "";
        });
      }
    });
  }

  const catalog = document.querySelector("#produtos .cards");

  if (!catalog || !Array.isArray(window.products)) {
    return;
  }

  catalog.innerHTML = window.products.map((product, index) => {

    const storages = Array.isArray(product.storages)
      ? product.storages
      : [{
          storage: product.storage || "",
          price: product.price || ""
        }];

    const firstStorage = storages[0] || {
      storage: "",
      price: ""
    };

    return `
    <article class="product-card" data-product-index="${index}">

      <div class="product-badge">
        ${product.status || "Disponível"}
      </div>

      ${
        !product.gallery &&
        !(Array.isArray(product.colors) && product.colors.length && product.colors[0]?.gallery)
          ? `
            <div class="product-photo">
              <img
                src="${product.image}"
                alt="${product.name}"
              >
            </div>
          `
          : ""
      }

      <div class="product-info">

        ${
          (product.gallery || (Array.isArray(product.colors) && product.colors[0]?.gallery))
            ? `
              <div class="product-gallery">
                <div class="gallery-main">
                  <img
                    src="${product.gallery ? product.gallery[0] : product.colors[0].gallery[0]}"
                    alt="${product.name}"
                    class="gallery-main-image"
                    loading="lazy"
                  >
                </div>

                <div class="gallery-thumbs">
                  ${(product.gallery || product.colors[0].gallery).map((img, i) => `
                    <button
                      type="button"
                      class="gallery-thumb ${i === 0 ? "active" : ""}"
                      onclick="changeProductImage(this, '${img}')"
                      aria-label="Ver imagem ${i + 1} de ${product.name}"
                    >
                      <img
                        src="${img}"
                        alt="${product.name} - imagem ${i + 1}"
                        loading="lazy"
                      >
                    </button>
                  `).join("")}
                </div>
              </div>
            `
            : ""
        }

        <h3>${product.name}</h3>

        ${
          product.description
            ? `<p class="product-description">${product.description}</p>`
            : ""
        }

        ${
          Array.isArray(product.colors) && product.colors.length
            ? `
              <div class="colors-selector">
                <button
                  type="button"
                  class="colors-toggle"
                  onclick="toggleColors(this)"
                >
                  <span>Cores:</span>
                  <span class="colors-arrow">▼</span>
                </button>

                <div class="colors-options">
                  ${product.colors.map(color => `
                    <button
                      type="button"
                      class="color-option"
                      onclick="selectColor(this)"
                    >
                      ${typeof color === "string" ? color : color.name}
                    </button>
                  `).join("")}
                </div>
              </div>
            `
            : ""
        }

        <div class="storage-selector">
          ${storages.map((item, storageIndex) => `
            <button
              type="button"
              class="storage-option ${storageIndex === 0 ? "active" : ""}"
              onclick="selectStorage(this, ${index}, ${storageIndex})"
            >
              ${item.storage}
            </button>
          `).join("")}
        </div>

        <p class="selected-storage">${firstStorage.storage}</p>

        <strong class="selected-price">${firstStorage.price}</strong>

        <small>
          ${product.status || "Disponível"}
        </small>

        <div class="product-actions">

          <a
            class="product-button cart-button"
            href="#"
            onclick="addProductToCart(${index}); return false;"
          >
            Adicionar ao carrinho
          </a>

          <a
            class="product-button"
            href="#atendimento"
            onclick="selectProduct(this)"
          >
            Consultar
          </a>

          <a
            class="product-button installment-button"
            href="/parcelamento.html"
            onclick="openInstallment(this); return false;"
          >
            Parcelamento
          </a>

          <a
            class="product-button whatsapp-button"
            href="#"
            onclick="openWhatsApp(this); return false;"
          >
            <svg class="whatsapp-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
              <path fill="currentColor"
                d="M20.52 3.48A11.87 11.87 0 0 0 12.07 0C5.52 0 .19 5.33.19 11.88c0 2.09.55 4.13 1.6 5.93L.1 24l6.35-1.66a11.82 11.82 0 0 0 5.62 1.43h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.23-6.15-3.44-8.41ZM12.08 21.77h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.77.99 1.01-3.67-.23-.38a9.86 9.86 0 1 1 8.39 4.65Zm5.42-7.39c-.3-.15-1.78-.88-2.05-.98-.27-.1-.47-.15-.67.15-.2.3-.77.98-.94 1.18-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.06 2.89 1.21 3.09.15.2 2.09 3.19 5.07 4.48.71.31 1.26.49 1.69.63.71.23 1.35.2 1.86.12.57-.08 1.78-.73 2.03-1.44.25-.71.25-1.32.17-1.44-.07-.12-.27-.2-.57-.35Z"
              />
            </svg>
            <span>WhatsApp</span>
          </a>

        </div>

      </div>

    </article>
    `;
  }).join("");

});


function addProductToCart(index) {
  const product = window.products[index];
  if (!product) return;

  const card = document.querySelector(
    `.product-card[data-product-index="${index}"]`
  );

  const storage =
    card?.querySelector(".selected-storage")?.textContent.trim() || "";

  const price =
    card?.querySelector(".selected-price")?.textContent.trim() || "";

  const selectedStorage =
    product.storages?.find(item => item.storage === storage);

  const cartProduct = {
    ...product,
    storage,
    price,
    ...(selectedStorage || {}),
    id: `${product.name}-${storage}`
      .replace(/\s+/g, "-")
      .toLowerCase()
  };

  addToCart(cartProduct);
}


function toggleColors(button) {
  const container = button.closest(".colors-selector");
  if (!container) return;

  container.classList.toggle("open");

  const arrow = button.querySelector(".colors-arrow");

  if (arrow) {
    arrow.textContent =
      container.classList.contains("open") ? "▲" : "▼";
  }
}

function selectColor(button) {
  const container = button.closest(".colors-selector");
  if (!container) return;

  container.querySelectorAll(".color-option").forEach(option => {
    option.classList.remove("active");
  });

  button.classList.add("active");

  const color = button.textContent.trim();
  const card = button.closest(".product-card");

  if (!card) return;

  const productName = card.querySelector(".product-name, h2, h3");
  if (!productName) return;

  const name = productName.textContent.trim();
  const gallery = card.querySelector(".product-gallery");

  if (!gallery) return;

  const mainImage = gallery.querySelector(".gallery-main-image");
  const thumbsContainer = gallery.querySelector(".gallery-thumbs");

  if (!mainImage || !thumbsContainer) return;

  let images = [];

  // iPhone 14: alternar entre as galerias Preto e Branco
  if (name === "iPhone 14") {
    const productIndex = Array.from(
      document.querySelectorAll(".product-card")
    ).indexOf(card);

    const product = window.products[productIndex];

    if (product && Array.isArray(product.colors)) {
      const selectedColor = product.colors.find(
        item => (typeof item === "string" ? item : item.name) === color
      );

      if (selectedColor && Array.isArray(selectedColor.gallery)) {
        images = selectedColor.gallery;
      }
    }
  }

  // iPhone 14 Plus: alternar entre as galerias Azul, Roxo e Amarelo
  if (name === "iPhone 14 Plus") {
    const productIndex = Array.from(
      document.querySelectorAll(".product-card")
    ).indexOf(card);

    const product = window.products[productIndex];

    if (product && Array.isArray(product.colors)) {
      const selectedColor = product.colors.find(
        item => (typeof item === "string" ? item : item.name) === color
      );

      if (selectedColor && Array.isArray(selectedColor.gallery)) {
        images = selectedColor.gallery;
      }
    }
  }

  // iPhone 13 mini
  if (name === "iPhone 13 mini") {
    const productIndex = Array.from(
      document.querySelectorAll(".product-card")
    ).indexOf(card);

    const product = window.products[productIndex];

    if (product && Array.isArray(product.colors)) {
      const selectedColor = product.colors.find(
        item => (typeof item === "string" ? item : item.name) === color
      );

      if (selectedColor && Array.isArray(selectedColor.gallery)) {
        images = selectedColor.gallery;
      }
    }
  }

  // iPhone 14 Pro: carregar a galeria da cor selecionada
  else if (name === "iPhone 14 Pro") {
    const productIndex = Array.from(
      document.querySelectorAll(".product-card")
    ).indexOf(card);

    const product = window.products[productIndex];

    if (product && Array.isArray(product.colors)) {
      const selectedColor = product.colors.find(
        item => (typeof item === "string" ? item : item.name) === color
      );

      if (selectedColor && Array.isArray(selectedColor.gallery)) {
        images = selectedColor.gallery;
      }
    }
  }

  // iPhone 11 Pro Max
  else if (name === "iPhone 11 Pro Max" && color === "Verde") {
    images = GREEN_GALLERY_11_PRO_MAX;
  }

  else if (name === "iPhone 11 Pro Max" && color === "Prata") {
    const productIndex = Array.from(
      document.querySelectorAll(".product-card")
    ).indexOf(card);

    const product = window.products[productIndex];

    if (product && Array.isArray(product.gallery)) {
      images = product.gallery;
    }
  }

  // iPhone 12 mini
  else if (name === "iPhone 12 mini" && color === "Azul") {
    images = BLUE_GALLERY_12_MINI;
  }

  else if (name === "iPhone 12 mini" && color === "Vermelho") {
    images = RED_GALLERY_12_MINI;
  }

  else if (name === "iPhone 12 mini" && color === "Verde") {
    images = GREEN_GALLERY_12_MINI;
  }

  // iPhone 12
  else if (name === "iPhone 12" && color === "Branco") {
    images = WHITE_GALLERY_12;
  }

  else if (name === "iPhone 12" && color === "Preto") {
    images = BLACK_GALLERY_12;
  }

  else if (name === "iPhone 12" && color === "Roxo") {
    images = PURPLE_GALLERY_12;
  }

  // iPhone 12 Pro Max
  else if (name === "iPhone 12 Pro Max" && color === "Grafite") {
    images = GRAPHITE_GALLERY_12_PRO_MAX;
  }

  else if (name === "iPhone 12 Pro Max" && color === "Prata") {
    images = SILVER_GALLERY_12_PRO_MAX;
  }

  else if (name === "iPhone 12 Pro Max" && color === "Azul Pacífico") {
    images = PACIFIC_BLUE_GALLERY_12_PRO_MAX;
  }

  // iPhone 13 Pro Max
  else if (name === "iPhone 13 Pro Max" && color === "Verde-alpino") {
    const productIndex = Array.from(
      document.querySelectorAll(".product-card")
    ).indexOf(card);

    const product = window.products[productIndex];

    if (product && Array.isArray(product.gallery)) {
      images = product.gallery.slice(0, 9);
    }
  }

  else if (name === "iPhone 13 Pro Max" && color === "Dourado") {
    const productIndex = Array.from(
      document.querySelectorAll(".product-card")
    ).indexOf(card);

    const product = window.products[productIndex];

    if (product && Array.isArray(product.gallery)) {
      images = product.gallery.slice(9, 18);
    }
  }

  else if (name === "iPhone 13 Pro Max" && color === "Grafite") {
    const productIndex = Array.from(
      document.querySelectorAll(".product-card")
    ).indexOf(card);

    const product = window.products[productIndex];

    if (product && Array.isArray(product.gallery)) {
      images = product.gallery.slice(18, 24);
    }
  }

  // Outras situações: galeria original
  else {
    const productIndex = Array.from(
      document.querySelectorAll(".product-card")
    ).indexOf(card);

    const product = window.products[productIndex];

    if (product && Array.isArray(product.gallery)) {
      images = product.gallery;
    }
  }

  if (!images.length) return;

  mainImage.src = images[0];

  thumbsContainer.innerHTML = images.map((img, index) => `
    <button
      type="button"
      class="gallery-thumb ${index === 0 ? "active" : ""}"
      onclick="changeProductImage(this, '${img}')"
    >
      <img src="${img}" alt="Imagem ${index + 1}">
    </button>
  `).join("");
}

function selectStorage(button, productIndex, storageIndex) {

  const product = window.products[productIndex];

  if (!product || !Array.isArray(product.storages)) {
    return;
  }

  const storage = product.storages[storageIndex];

  if (!storage) {
    return;
  }

  const card = button.closest(".product-card");

  if (!card) {
    return;
  }

  card.querySelectorAll(".storage-option").forEach(option => {
    option.classList.remove("active");
  });

  button.classList.add("active");

  const storageText =
    card.querySelector(".selected-storage");

  const priceText =
    card.querySelector(".selected-price");

  if (storageText) {
    storageText.textContent = storage.storage;
  }

  if (priceText) {
    priceText.textContent = storage.price;
  }
}


function openInstallment(button) {
  const card = button.closest(".product-card");

  if (!card) return;

  const product = card.querySelector("h3")?.textContent.trim() || "";
  const storage = card.querySelector(".selected-storage")?.textContent.trim() || "";
  const price = card.querySelector(".selected-price")?.textContent.trim() || "";

  const params = new URLSearchParams({
    product,
    storage,
    price
  });

  window.location.href = `/parcelamento.html?${params.toString()}`;
}

function openWhatsApp(button) {

  const card = button.closest(".product-card");

  if (!card) return;

  const name =
    card.querySelector("h3")?.textContent.trim() || "";

  const storage =
    card.querySelector(".product-info p")?.textContent.trim() || "";

  const price =
    card.querySelector("strong")?.textContent.trim() || "";

  const product =
    `${name} ${storage}`.trim();

  const message =
    `Olá! Tenho interesse no ${product}. ` +
    `Gostaria de saber mais informações. ` +
    `Valor informado: ${price}.`;

  const url =
    `https://wa.me/5511951507876?text=${encodeURIComponent(message)}`;

  window.open(url, "_blank");

}


function selectProduct(button) {
  const card = button.closest(".product-card");
  if (!card) return;

  const product = card.querySelector("h3")?.textContent.trim() || "";
  const storage = card.querySelector(".selected-storage")?.textContent.trim() || "";
  const price = card.querySelector(".selected-price")?.textContent.trim() || "";

  const select = document.querySelector('select[name="product"]');

  if (select) {
    const label = `${product} — ${storage} — ${price}`;

    let option = Array.from(select.options).find(
      item => item.value === label
    );

    if (!option) {
      option = document.createElement("option");
      option.value = label;
      option.textContent = label;
      select.appendChild(option);
    }

    select.value = label;
  }

  const atendimento = document.querySelector("#atendimento");

  if (atendimento) {
    atendimento.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });
  }
}


</script>


<!-- CARRINHO -->
<button id="cartButton" class="cart-floating" onclick="openCart()" aria-label="Abrir carrinho">
  🛒
  <span id="cartCount">0</span>
</button>

<div id="cartPanel" class="cart-panel">
  <div class="cart-header">
    <h2>Seu carrinho</h2>
    <button class="cart-close" onclick="closeCart()">×</button>
  </div>

  <div id="cartItems" class="cart-items"></div>

  <div class="cart-footer">
    <div class="cart-total-row">
      <span>Total</span>
      <strong id="cartTotal">R$ 0,00</strong>
    </div>

    <button class="cart-checkout" onclick="checkoutCart()">
      Finalizar pedido
    </button>
  </div>
</div>

<style>
.cart-floating {
  position: fixed;
  right: 18px;
  bottom: 20px;
  width: 52px;
  height: 52px;
  border: 0;
  border-radius: 50%;
  background: #111;
  color: #fff;
  font-size: 22px;
  z-index: 9998;
  box-shadow: 0 8px 25px rgba(0,0,0,.25);
  cursor: pointer;
}

#cartCount {
  position: absolute;
  top: -5px;
  right: -4px;
  min-width: 21px;
  height: 21px;
  padding: 0 5px;
  border-radius: 20px;
  background: #25d366;
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  display: none;
  align-items: center;
  justify-content: center;
}

.cart-panel {
  position: fixed;
  top: 0;
  right: -420px;
  width: min(400px, 92vw);
  height: 100vh;
  background: #fff;
  z-index: 9999;
  box-shadow: -8px 0 30px rgba(0,0,0,.2);
  transition: right .25s ease;
  display: flex;
  flex-direction: column;
}

.cart-panel.open {
  right: 0;
}

.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px;
  border-bottom: 1px solid #eee;
}

.cart-header h2 {
  margin: 0;
  font-size: 22px;
}

.cart-close {
  border: 0;
  background: #f1f1f1;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  font-size: 25px;
  cursor: pointer;
}

.cart-items {
  flex: 1;
  overflow-y: auto;
  padding: 15px;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}

.cart-item img {
  width: 65px;
  height: 65px;
  object-fit: contain;
  border-radius: 10px;
  background: #f5f5f5;
}

.cart-item-info {
  flex: 1;
}

.cart-item-info h4 {
  margin: 0 0 5px;
  font-size: 15px;
}

.cart-item-info p {
  margin: 0 0 8px;
  font-weight: 700;
}

.quantity {
  display: flex;
  align-items: center;
  gap: 10px;
}

.quantity button {
  width: 30px;
  height: 30px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background: #fff;
  font-size: 18px;
}

.remove-cart {
  border: 0;
  background: transparent;
  color: #888;
  font-size: 25px;
}

.cart-footer {
  padding: 18px;
  border-top: 1px solid #eee;
}

.cart-total-row {
  display: flex;
  justify-content: space-between;
  font-size: 18px;
  margin-bottom: 15px;
}

.cart-checkout {
  width: 100%;
  padding: 15px;
  border: 0;
  border-radius: 12px;
  background: #25d366;
  color: #fff;
  font-size: 16px;
  font-weight: 700;
}

.cart-empty {
  text-align: center;
  padding: 50px 20px;
  color: #777;
}

/* Melhor enquadramento dos produtos no celular */
@media (max-width: 600px) {

  #produtos .cards {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
  }

  #produtos .product-card {
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    border-radius: 16px;
  }

  #produtos .product-photo {
    width: 100%;
    height: 115px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #produtos .product-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #produtos .product-info {
    padding: 9px 7px;
    min-width: 0;
  }

  #produtos .product-info h3 {
    font-size: 15px;
    line-height: 1.2;
    margin: 0 0 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #produtos .product-info p {
    font-size: 13px;
    margin: 0 0 7px;
  }

  #produtos .product-info strong {
    display: block;
    font-size: 16px;
    line-height: 1.2;
    margin-bottom: 6px;
  }

  #produtos .product-info small {
    font-size: 11px;
  }

  
.storage-selector {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6px;
  width: 100%;
  margin: 8px 0 6px;
}

.storage-option {
  width: 100%;
  height: 32px;
  padding: 5px 4px;
  border: 1px solid #ddd;
  border-radius: 7px;
  background: #fff;
  color: #111;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  box-sizing: border-box;
  white-space: nowrap;
}

.storage-option.active {
  background: #111;
  color: #fff;
  border-color: #111;
}

.selected-storage {
  display: none;
}

.selected-price {
  display: block;
  margin-top: 4px;
}

.product-actions {
    display: grid !important;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(2, 48px);
    gap: 7px;
    width: 100%;
    margin-top: 10px;
  }

  .product-actions .product-button {
    width: 100%;
    min-width: 0;
    height: 48px;
    min-height: 48px;
    box-sizing: border-box;
    padding: 9px 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.15;
    white-space: normal;
    font-size: 11px;
    overflow: hidden;
  }

  .product-actions .cart-button {
    font-size: 11px;
  }

  .product-actions .product-button:not(.whatsapp-button) {
    background: #3a3a3a !important;
    color: #fff !important;
    border: 1px solid #3a3a3a !important;
  }

  .product-actions .installment-button {
    width: 50% !important;
    justify-self: center;
    grid-column: 1 / 3;
    min-width: 0 !important;
    margin: 0;
    box-sizing: border-box;
    transform: none;
    padding-left: 5px !important;
    padding-right: 5px !important;
    font-size: 11px !important;
    letter-spacing: normal;
    white-space: normal !important;
    overflow: hidden;
  }
}

@media (max-width: 380px) {
  #produtos .cards {
    gap: 8px;
  }

  #produtos .product-info {
    padding: 10px 7px;
  }

  .product-actions {
    gap: 5px;
  }

  .product-actions .product-button {
    font-size: 10px;
    padding-left: 3px;
    padding-right: 3px;
  }
}


/* =========================
   GALERIA DE PRODUTOS
========================= */

.product-gallery {
  width: 100%;
  margin-bottom: 10px;
}

.gallery-main {
  width: 100%;
  height: 230px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}

.gallery-main-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.gallery-thumbs {
  display: flex;
  gap: 6px;
  margin-top: 7px;
  width: 100%;
  overflow-x: auto;
  scrollbar-width: none;
}

.gallery-thumbs::-webkit-scrollbar {
  display: none;
}

.gallery-thumb {
  flex: 0 0 52px;
  width: 52px;
  height: 52px;
  padding: 2px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background: #fff;
  cursor: pointer;
  overflow: hidden;
}

.gallery-thumb.active {
