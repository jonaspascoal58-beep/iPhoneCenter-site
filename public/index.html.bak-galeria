footer {
  position: relative;
  overflow: visible !important;
  background:
    radial-gradient(
      ellipse 420px 600px at -60px 50%,
      rgba(40, 120, 255, 0.15) 0%,
      rgba(40, 120, 255, 0.07) 40%,
      rgba(40, 120, 255, 0) 75%
    ),
    radial-gradient(
      ellipse 420px 600px at calc(100% + 60px) 50%,
      rgba(40, 120, 255, 0.15) 0%,
      rgba(40, 120, 255, 0.07) 40%,
      rgba(40, 120, 255, 0) 75%
    ) !important;
  background-attachment: fixed;
}

</style>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.querySelector(".header-search");
  const input = form ? form.querySelector("input") : null;

  if (!form || !input || !Array.isArray(window.products)) return;

  form.style.position = "relative";

  const preview = document.createElement("div");
  preview.className = "search-preview";
  preview.setAttribute("role", "listbox");
  preview.hidden = true;
  form.appendChild(preview);

  function hidePreview() {
    preview.hidden = true;
    preview.innerHTML = "";
  }

  function showPreview() {
    const query = input.value.trim().toLowerCase();

    if (!query) {
      hidePreview();
      return;
    }

    const matches = window.products
      .map((product, index) => ({ product, index }))
      .filter(({ product }) => (product.name || "").toLowerCase().includes(query))

    if (!matches.length) {
      preview.innerHTML = '<div class="search-preview-empty">Nenhum produto encontrado.</div>';
      preview.hidden = false;
      return;
    }

    preview.innerHTML = matches.map(({ product, index }) => {
      const image = product.gallery && product.gallery.length
        ? product.gallery[0]
        : (product.image || "");
      const price = product.storages && product.storages.length
        ? product.storages[0].price
        : product.price;

      return `
        <button type="button" class="search-preview-item" data-product-index="${index}">
          <img src="${image}" alt="" loading="lazy">
          <span class="search-preview-details">
            <strong>${product.name || "iPhone"}</strong>
            <small>${price ? "A partir de " + price : "Consulte o preço"}</small>
          </span>
        </button>
      `;
    }).join("");

    preview.hidden = false;
  }

  input.addEventListener("input", showPreview);
  input.addEventListener("focus", showPreview);

  preview.addEventListener("click", function (event) {
    const item = event.target.closest(".search-preview-item");
    if (!item) return;

    const index = Number(item.dataset.productIndex);
    const card = document.querySelector('#produtos .product-card[data-product-index="' + index + '"]');

    hidePreview();

    if (card) {
      document.querySelectorAll("#produtos .product-card").forEach(el => {
        el.style.display = "";
      });
      card.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  });

  document.addEventListener("click", function (event) {
    if (!form.contains(event.target)) hidePreview();
  });

  form.addEventListener("submit", hidePreview);
});
</script>


<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".category-bar [data-model]").forEach(function (link) {
    link.addEventListener("click", function (event) {
      event.preventDefault();

      const chosenModel = (link.dataset.model || "").trim().toLowerCase();
      const products = Array.isArray(window.products) ? window.products : [];

      const index = products.findIndex(function (product) {
        return (product.name || "").trim().toLowerCase() === chosenModel;
      });

      if (index === -1) {
        console.warn("Modelo não encontrado no catálogo:", link.dataset.model);
        return;
      }

      document.querySelectorAll("#produtos .product-card").forEach(function (card) {
        card.style.display = "";
      });

      const target = document.querySelector(
        '#produtos .product-card[data-product-index="' + index + '"]'
      );

      if (target) {
        target.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });
  });
});
</script>

</body>
</html>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.querySelector(".header-search");
  const input = form?.querySelector("input");
  const header = document.querySelector(".header-main");
  const preview = form?.querySelector(".search-preview");

  if (!form || !input || !header || !preview) return;

  header.style.position = "relative";
  header.appendChild(preview);

  function positionPreview() {
    preview.style.left = form.offsetLeft + "px";
    preview.style.top = (form.offsetTop + form.offsetHeight + 8) + "px";
    preview.style.width = form.offsetWidth + "px";
  }

  positionPreview();
  window.addEventListener("resize", positionPreview);

  function goToProduct() {
    const query = input.value.trim().toLowerCase();
    if (!query || !Array.isArray(window.products)) return;

    const foundIndex = window.products.findIndex(product =>
      (product.name || "").toLowerCase().includes(query)
    );

    if (foundIndex < 0) return;

    document.querySelectorAll("#produtos .product-card").forEach(card => {
      card.style.display = "";
    });

    const target = document.querySelector(
      '#produtos .product-card[data-product-index="' + foundIndex + '"]'
    );

    if (target) {
      preview.hidden = true;
      target.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }

  form.addEventListener("submit", function (event) {
    event.preventDefault();
    goToProduct();
  });

  input.addEventListener("keydown", function (event) {
    if (event.key === "Enter") {
      event.preventDefault();
      goToProduct();
    }
  });
});
</script>

<script>
function irParaUltimoIphone() {
  const ultimoIndex = window.products.length - 1;
  const ultimoCard = document.querySelector(
    '#produtos .product-card[data-product-index="' + ultimoIndex + '"]'
  );

  if (ultimoCard) {
    ultimoCard.scrollIntoView({
      behavior: "smooth",
      block: "center"
    });

    ultimoCard.click();
  }
}
</script>
