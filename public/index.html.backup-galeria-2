<script>

document.addEventListener("DOMContentLoaded", function () {

  const catalog = document.querySelector("#produtos .cards");

  if (!catalog || !Array.isArray(window.products)) {
    return;
  }

  catalog.innerHTML = window.products.map((product, index) => `
    <article class="product-card">

      <div class="product-badge">
        ${product.status || "Disponível"}
      </div>

      <div class="product-photo">
        <img
          src="${product.image}"
          alt="${product.name} ${product.storage}"
        >
      </div>

      <div class="product-info">

        <h3>${product.name}</h3>

        <p>${product.storage}</p>

        <strong>${product.price}</strong>

        <small>
          ${product.status || "Disponível"}
        </small>

        <div class="product-actions">
          <a
            class="product-button cart-button"
            href="#"
            onclick="addProductToCart(${index}); return false;"
          >
            Adicionar ao carrinho
          </a>


          <a
            class="product-button"
            href="#atendimento"
            onclick="selectProduct(this)"
          >
            Consultar
          </a>

          <a
            class="product-button installment-button"
            href="/parcelamento.html"
          >
            Parcelamento
          </a>

          <a
            class="product-button whatsapp-button"
            href="#"
            onclick="openWhatsApp(this); return false;"
          >
            <svg class="whatsapp-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
              <path fill="currentColor"
                d="M20.52 3.48A11.87 11.87 0 0 0 12.07 0C5.52 0 .19 5.33.19 11.88c0 2.09.55 4.13 1.6 5.93L.1 24l6.35-1.66a11.82 11.82 0 0 0 5.62 1.43h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.23-6.15-3.44-8.41ZM12.08 21.77h-.01a9.86 9.86 0 0 1-5.03-1.38l-.36-.21-3.77.99 1.01-3.67-.23-.38a9.86 9.86 0 1 1 8.39 4.65Zm5.42-7.39c-.3-.15-1.78-.88-2.05-.98-.27-.1-.47-.15-.67.15-.2.3-.77.98-.94 1.18-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.06 2.89 1.21 3.09.15.2 2.09 3.19 5.07 4.48.71.31 1.26.49 1.69.63.71.23 1.35.2 1.86.12.57-.08 1.78-.73 2.03-1.44.25-.71.25-1.32.17-1.44-.07-.12-.27-.2-.57-.35Z"
              />
            </svg>
            <span>WhatsApp</span>
          </a>

        </div>

      </div>

    </article>
  `).join("");

});


function addProductToCart(index) {
  const product = window.products[index];
  if (!product) return;

  const cartProduct = {
    ...product,
    id: product.id || `${product.name}-${product.storage}`.replace(/\s+/g, "-").toLowerCase()
  };

  addToCart(cartProduct);
}

function openWhatsApp(button) {

  const card = button.closest(".product-card");

  if (!card) return;

  const name =
    card.querySelector("h3")?.textContent.trim() || "";

  const storage =
    card.querySelector(".product-info p")?.textContent.trim() || "";

  const price =
    card.querySelector("strong")?.textContent.trim() || "";

  const product =
    `${name} ${storage}`.trim();

  const message =
    `Olá! Tenho interesse no ${product}. ` +
    `Gostaria de saber mais informações. ` +
    `Valor informado: ${price}.`;

  const url =
    `https://wa.me/5511951507876?text=${encodeURIComponent(message)}`;

  window.open(url, "_blank");

}


function selectProduct(button) {

  const card = button.closest(".product-card");

  if (!card) return;

  const name =
    card.querySelector("h3")?.textContent.trim() || "";

  const storage =
    card.querySelector(".product-info p")?.textContent.trim() || "";

  const select =
    document.querySelector('select[name="product"]');

  if (!select) return;

  const value =
    `${name} ${storage}`.trim();

  const exists =
    [...select.options].some(option => option.value === value);

  if (!exists) {

    const option =
      document.createElement("option");

    option.value = value;
    option.textContent = value;

    select.appendChild(option);

  }

  select.value = value;

}


</script>


