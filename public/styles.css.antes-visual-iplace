/* =========================================================
   iPhoneCenter — Catálogo
   ========================================================= */

#produtos .cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
}

#produtos .card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24px;
  min-height: 460px;
  border: 1px solid #20242c;
  border-radius: 26px;
  background: linear-gradient(145deg, #101319, #080a0d);
  box-shadow: 0 18px 45px rgba(0,0,0,.25);
  transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
}

#produtos .card:hover {
  transform: translateY(-6px);
  border-color: #343a46;
  box-shadow: 0 25px 60px rgba(0,0,0,.38);
}

#produtos .product-image {
  width: 100%;
  height: 250px;
  object-fit: contain;
  display: block;
  margin: 0 auto 18px;
  background: #f7f7f7;
  border-radius: 20px;
  padding: 14px;
  transition: transform .25s ease;
}

#produtos .card:hover .product-image {
  transform: scale(1.025);
}

#produtos .card h3 {
  margin: 4px 0 5px;
  font-size: 22px;
  line-height: 1.2;
}

#produtos .card p {
  margin: 0 0 7px;
  color: #9299a6;
  font-size: 14px;
}

#produtos .card strong {
  display: block;
  margin: 5px 0 2px;
  color: #22c55e;
  font-size: 24px;
  letter-spacing: -.5px;
}

#produtos .product-status {
  display: block;
  margin-bottom: 16px;
  color: #aeb4c0;
  font-size: 12px;
}

#produtos .card .button {
  min-width: 125px;
  margin: 4px;
}

@media (max-width: 650px) {
  #produtos .cards {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  #produtos .card {
    min-height: auto;
    padding: 20px;
  }

  #produtos .product-image {
    height: 230px;
  }
}


/* Catálogo: 2 produtos por linha */
#produtos .cards {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (max-width: 650px) {
  #produtos .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  #produtos .card {
    padding: 14px;
  }

  #produtos .product-image {
    height: 175px;
  }

  #produtos .card h3 {
    font-size: 17px;
  }

  #produtos .card strong {
    font-size: 18px;
  }

  #produtos .card .button {
    width: 100%;
    min-width: 0;
    margin: 4px 0;
  }
}


/* Botão WhatsApp */
#produtos .button.whatsapp-button {
  background: #25D366;
  border-color: #25D366;
  color: #fff;
  gap: 8px;
}

#produtos .button.whatsapp-button:hover {
  background: #20bd5a;
  border-color: #20bd5a;
}

#produtos .button.whatsapp-button .whatsapp-icon {
  width: 18px;
  height: 18px;
  margin: 0;
  flex-shrink: 0;
}


#produtos a.whatsapp-button {
  background: #25D366 !important;
  border-color: #25D366 !important;
  color: #ffffff !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

#produtos a.whatsapp-button .whatsapp-icon {
  width: 18px !important;
  height: 18px !important;
  margin: 0 !important;
  flex-shrink: 0;
}

#produtos a.whatsapp-button:hover {
  background: #20bd5a !important;
  border-color: #20bd5a !important;
}

